FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml alembic.ini ./
COPY src/ ./src/
COPY config/online.json ./config/online.json
RUN pip install --no-cache-dir ".[agents,portal,online,observability,player-memory]"

EXPOSE 8765
CMD ["python", "-m", "story_harness.cli.portal_api", "--profile", "online", "--config", "/app/config/online.json", "--port", "8765"]
