FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
FROM base AS build
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir uv==0.11.25
WORKDIR /build/platform
COPY pyproject.toml uv.lock LICENSE ./
COPY src/ ./src/
COPY scripts/build_harness.py ./scripts/build_harness.py
# The runtime lock excludes project identities and development/test extras.
RUN uv export --locked --no-default-groups \
        --extra agents --extra portal --extra online \
        --extra observability --extra player-memory \
        --no-emit-project --no-emit-package storyloop-harness \
        -o /runtime-requirements.txt \
    && python -m pip download --no-deps --require-hashes \
        --only-binary=:all: --dest /wheels -r /runtime-requirements.txt
# PEP 517 build backend requirements remain independent of the runtime lock.
RUN python scripts/build_harness.py --out-dir /wheels \
    && uv build --no-sources --wheel . --out-dir /wheels \
    && python -m venv /opt/venv \
    && /opt/venv/bin/python -m pip install --no-cache-dir \
        --no-index --find-links=/wheels --no-deps --require-hashes \
        -r /runtime-requirements.txt \
    && /opt/venv/bin/python -m pip install --no-cache-dir \
        --no-index --no-deps \
        /wheels/storyloop_harness-*.whl /wheels/storyloop_platform-*.whl \
    && /opt/venv/bin/python -m pip check

FROM base AS runtime
ENV PATH="/opt/venv/bin:$PATH"
COPY --from=build /opt/venv /opt/venv
WORKDIR /app
COPY alembic.ini ./
# Shared model defaults are installed with the wheel; this deployment override
# may be replaced by the read-only settings mount in compose.yaml.
COPY config/online.json ./config/online.json

EXPOSE 8765
CMD ["python", "-m", "storyloop_platform.cli.portal_api", "--profile", "online", "--config", "/app/config/online.json", "--port", "8765"]
