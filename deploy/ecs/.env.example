# Copy to .env on the ECS. Keep .env out of Git and chmod 600 it.
# The PostgreSQL password must be URL-safe; for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_random_hex_password
STORY_DATA_DIR=/srv/storyloop-data
STORY_PRIVATE_DIR=/srv/storyloop-private
STORY_BAILIAN_API_KEY=replace_with_pay_as_you_go_key
STORY_ALLOWED_HOSTS=your.ecs.public.ip
STORY_ALLOWED_ORIGINS=http://your.ecs.public.ip

# Optional external Langfuse instance. Do not run its full stack on this 2c/4GiB ECS.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
STORY_TRACE_CONTENT=0
