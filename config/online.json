{
  "schema_version": 1,
  "environment": "online",
  "models": {
    "provider": "openai_compatible",
    "tool_choice_policy": "auto_only",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "base_url_env": "STORY_BAILIAN_BASE_URL",
    "api_key_env": "STORY_BAILIAN_API_KEY",
    "timeout_seconds": 90,
    "connect_timeout_seconds": 10,
    "max_retries": 2,
    "tasks": {
      "npc_selection": "qwen3.8-flash",
      "entity_extraction": "qwen3.8-flash",
      "intent_classification": "qwen3.8-flash",
      "work_selection": "qwen3.8-flash",
      "main_react": "qwen3.8-max",
      "npc_reply": "qwen3.8-max",
      "adjudication": "qwen3.8-max",
      "narration": "qwen3.8-max"
    }
  },
  "runtime": {
    "max_steps": 8,
    "max_npc_replies": 3,
    "main_max_iters": 4,
    "npc_max_iters": 3
  },
  "storage": {
    "driver": "postgresql",
    "url_env": "DATABASE_URL"
  },
  "memory": {
    "driver": "in_memory"
  },
  "http": {
    "allowed_hosts_env": "STORY_ALLOWED_HOSTS",
    "allowed_origins_env": "STORY_ALLOWED_ORIGINS"
  },
  "billing": {
    "welcome_points": 500,
    "points_per_rmb": 50,
    "pricing_version": "2026-10-02-cn-beijing-list",
    "models": {
      "qwen3.8-flash": {
        "input_rmb_per_million": "0.8",
        "output_rmb_per_million": "2.7",
        "cached_input_rmb_per_million": "0.1",
        "multiplier": "1"
      },
      "qwen3.8-max": {
        "input_rmb_per_million": "12",
        "output_rmb_per_million": "36",
        "cached_input_rmb_per_million": "1.5",
        "multiplier": "1"
      }
    }
  }
}
