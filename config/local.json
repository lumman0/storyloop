{
  "schema_version": 1,
  "environment": "local",
  "models": {
    "provider": "openai_compatible",
    "tool_choice_policy": "auto_only",
    "structured_output_transport": "tool_call",
    "base_url": "https://cn-hongkong.dashscope.aliyuncs.com/compatible-mode/v1",
    "api_key_env": "STORY_BAILIAN_API_KEY",
    "timeout_seconds": 90,
    "connect_timeout_seconds": 10,
    "max_retries": 2,
    "generate_kwargs": {
      "extra_body": {
        "enable_thinking": false
      }
    },
    "api_key_file": "application.local.json",
    "tasks": {
      "npc_selection": "deepseek-v4.1-flash",
      "entity_extraction": "deepseek-v4.1-flash",
      "intent_classification": "deepseek-v4.1-flash",
      "work_selection": "deepseek-v4.1-flash",
      "main_react": "deepseek-v4.1-flash",
      "npc_reply": "deepseek-v4.1-flash",
      "adjudication": "deepseek-v4.1-flash",
      "narration": "deepseek-v4.1-flash",
      "followup_actions": "deepseek-v4.1-flash"
    }
  },
  "runtime": {
    "max_steps": 8,
    "max_npc_replies": 3,
    "main_max_iters": 4,
    "npc_max_iters": 3
  },
  "storage": {
    "driver": "sqlite",
    "path": "story-game.sqlite3",
    "path_base": "cwd"
  },
  "memory": {
    "driver": "in_memory"
  },
  "player_memory": {
    "driver": "none",
    "llm_model": "qwen3.8-flash",
    "embedding_model": "text-embedding-v4",
    "embedding_dims": 1024
  },
  "billing": {
    "welcome_points": 500,
    "points_per_rmb": 50,
    "pricing_version": "2026-10-03-deepseek-v4.1-peak-reference",
    "models": {
      "deepseek-v4.1-flash": {
        "input_rmb_per_million": "2",
        "output_rmb_per_million": "8",
        "cached_input_rmb_per_million": "0.2",
        "multiplier": "1"
      },
      "qwen3.8-flash": {
        "input_rmb_per_million": "0.8",
        "output_rmb_per_million": "2.7",
        "cached_input_rmb_per_million": "0.1",
        "multiplier": "1"
      },
      "qwen3.8-max": {
        "input_rmb_per_million": "12",
        "output_rmb_per_million": "36",
        "cached_input_rmb_per_million": "1.5",
        "multiplier": "1"
      }
    }
  }
}
