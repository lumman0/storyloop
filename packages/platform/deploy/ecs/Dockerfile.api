FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY packages/harness/ /build/harness/
COPY packages/platform/pyproject.toml /build/platform/pyproject.toml
COPY packages/platform/src/ /build/platform/src/
RUN pip wheel --wheel-dir /wheels /build/harness "/build/platform[agents,portal,online,observability,player-memory]" \
    && pip install --no-cache-dir --no-index --find-links=/wheels "storyloop-platform[agents,portal,online,observability,player-memory]==0.1.0"
COPY alembic.ini ./
COPY config/online.json ./config/online.json

EXPOSE 8765
CMD ["python", "-m", "storyloop_platform.cli.portal_api", "--profile", "online", "--config", "/app/config/online.json", "--port", "8765"]
