FROM node:22-alpine AS build
WORKDIR /web
COPY packages/platform/web/package.json packages/platform/web/package-lock.json ./
RUN npm ci
COPY packages/platform/web/ ./
RUN npm run build

FROM nginx:stable-alpine
COPY packages/platform/deploy/ecs/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist/ /usr/share/nginx/html/
EXPOSE 80
