    "world": {"location": "harbor_square", "market_phase": "closed", "shop_window": {"broken": false}},
    "plot": {"market_day": "not_started", "pressure": 0},
    "actors": {
      "player": {"location": "harbor_square"},
      "dockhand": {"location": "harbor_square", "status": "setting_up"}
    }
  },
  "initial_work": [
    {"id": "harbor-opening-cue", "kind": "scenario_cue", "due_tick": 4, "priority": 20,
