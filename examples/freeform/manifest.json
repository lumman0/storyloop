       "effects": [{"path": ["world", "market_phase"], "value": "open"}, {"path": ["plot", "market_day"], "value": "first_day"}],
       "summary": "港口市集开门", "location": "harbor_square", "sensory": "开市钟响起，摊位开始营业。"}}
  ],
  "actions": [
    {"id": "break_shop_window", "label": "打破店铺橱窗", "location": "harbor_square",
     "when": {"path": ["world", "shop_window", "broken"], "value": false},
     "effects": [{"path": ["world", "shop_window", "broken"], "value": true}],
     "sensory": "玩家打破了店铺橱窗，碎玻璃散落在地。"}
  ]
